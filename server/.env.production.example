# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to version control!

# ============================================
# DATABASE
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-lms-prod?retryWrites=true&w=majority

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_256_BIT
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=production
TRUST_PROXY=true

# ============================================
# CORS & SECURITY
# ============================================
CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# PAYMENT GATEWAYS - PRODUCTION KEYS
# ============================================
# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=REPLACE_WITH_PRODUCTION_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# ============================================
# FILE STORAGE - CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Upload Configuration
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/avi,video/mov,video/wmv,video/flv,video/webm,application/pdf

# ============================================
# EMAIL CONFIGURATION
# ============================================
# SendGrid (Recommended for production)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ============================================
# SMS/OTP - TWILIO
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL=redis://:<password>@<host>:<port>
REDIS_TLS_ENABLED=true
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================
# PUSH NOTIFICATIONS
# ============================================
EXPO_ACCESS_TOKEN=your-expo-access-token

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=error
LOG_FILE_MAX_SIZE=10485760
LOG_MAX_FILES=10

# ============================================
# NOTIFICATION SETTINGS
# ============================================
ENABLE_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=true

# ============================================
# SECURITY
# ============================================
HELMET_CSP_ENABLED=true
SESSION_SECRET=REPLACE_WITH_STRONG_SECRET
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ============================================
# SUPER ADMIN
# ============================================
SUPER_ADMIN_SECRET=REPLACE_WITH_STRONG_SECRET

# ============================================
# MONITORING & ANALYTICS
# ============================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
NEW_RELIC_LICENSE_KEY=your-license-key
NEW_RELIC_APP_NAME=smart-lms-api

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
