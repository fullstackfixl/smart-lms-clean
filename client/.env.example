# Frontend Environment Variables
# Copy to .env.local for dev, set in Vercel Dashboard for production

# Backend API URL (Render deployment)
NEXT_PUBLIC_API_URL=https://smart-lms-clean-1.onrender.com

# App URL
NEXT_PUBLIC_APP_URL=https://smart-lms-clean.vercel.app

# Razorpay public key (optional, for payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
